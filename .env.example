# ===========================================================
# SUPABASE - Lấy từ Project Settings → API trong Supabase Dashboard
# ===========================================================

# URL dự án Supabase (public, OK để commit)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# anon/public key (public, dùng ở client-side)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# service_role key - TUYỆT ĐỐI KHÔNG commit key thật, chỉ dùng ở server
# Dùng cho: tạo signed URL, admin operations
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ===========================================================
# APP CONFIG
# ===========================================================

# URL production (Vercel sẽ tự set, để trống khi dev)
NEXT_PUBLIC_APP_URL=https://your-app.vercel.app

# Tên ứng dụng
NEXT_PUBLIC_APP_NAME=Nhật Ký Tình Yêu

# ===========================================================
# THÔNG BÁO ĐẨY (Web Push)
# Tạo cặp khóa bằng:  npx web-push generate-vapid-keys
# ===========================================================

# Khóa công khai (dùng ở trình duyệt)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your-vapid-public-key

# Khóa riêng - CHỈ dùng ở server, KHÔNG commit key thật
VAPID_PRIVATE_KEY=your-vapid-private-key

# Địa chỉ liên hệ của bạn, dạng mailto: hoặc https://
VAPID_SUBJECT=mailto:you@example.com
